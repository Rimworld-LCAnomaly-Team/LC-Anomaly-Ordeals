<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Independent ordeal race hierarchy. It inherits only RimWorld's generic pawn shell. -->
  <ThingDef Name="LCOrdeal_RaceBase" ParentName="BasePawn" Abstract="True">
    <description>A transient hostile manifestation created by an Ordeal.</description>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <receivesSignals>true</receivesSignals>
    <tradeability>None</tradeability>
    <statBases>
      <Mass>60</Mass><Flammability>0</Flammability><MarketValue>0</MarketValue><PsychicSensitivity>0.5</PsychicSensitivity>
      <ToxicResistance>1</ToxicResistance><ToxicEnvironmentResistance>1</ToxicEnvironmentResistance><ComfyTemperatureMin>-100</ComfyTemperatureMin><ComfyTemperatureMax>250</ComfyTemperatureMax><MeatAmount>0</MeatAmount><ArmorRating_Heat>2</ArmorRating_Heat>
    </statBases>
    <race>
      <renderTree>Misc</renderTree><fleshType>LCOrdeal_ManifestationFlesh</fleshType><needsRest>false</needsRest><hasGenders>false</hasGenders><foodType>None</foodType><lifeExpectancy>2500</lifeExpectancy><bloodDef>Filth_MachineBits</bloodDef><intelligence>ToolUser</intelligence><thinkTreeMain>Mechanoid</thinkTreeMain><canFlyInVacuum>true</canFlyInVacuum>
      <lifeStageAges>
        <li><def>MechanoidFullyFormed</def><minAge>0</minAge><soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded><soundDeath>Pawn_Mech_Scyther_Death</soundDeath><soundCall>Pawn_Mech_Scyther_Call</soundCall></li>
        <li MayRequire="Ludeon.RimWorld.Biotech"><def>MechanoidFullyFormed</def><minAge>100</minAge><soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded><soundDeath>Pawn_Mech_Scyther_Death</soundDeath><soundCall>Pawn_Mech_Scyther_Call</soundCall></li>
      </lifeStageAges>
    </race>
  </ThingDef>

  <ThingDef Name="LCOrdeal_RaceSmall" ParentName="LCOrdeal_RaceBase" Abstract="True">
    <statBases><MoveSpeed>3.75</MoveSpeed><ArmorRating_Blunt>0.18</ArmorRating_Blunt><ArmorRating_Sharp>0.72</ArmorRating_Sharp></statBases>
    <race><body>BeetleLike</body><baseBodySize>0.2</baseBodySize><baseHealthScale>0.4</baseHealthScale><soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn><soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding><soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss></race>
    <tools><li><label>mandibles</label><capacities><li>Bite</li></capacities><power>5</power><cooldownTime>2</cooldownTime><linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup></li></tools>
  </ThingDef>
  <ThingDef Name="LCOrdeal_RaceLarge" ParentName="LCOrdeal_RaceBase" Abstract="True">
    <statBases><MoveSpeed>3.6</MoveSpeed><ArmorRating_Blunt>0.18</ArmorRating_Blunt><ArmorRating_Sharp>0.27</ArmorRating_Sharp></statBases>
    <race><body>BeetleLikeWithClaw</body><baseBodySize>1.2</baseBodySize><baseHealthScale>2.5</baseHealthScale><soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn><soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding><soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss></race>
    <tools><li><label>head claw</label><capacities><li>Cut</li></capacities><power>12</power><cooldownTime>2.6</cooldownTime><linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup></li></tools>
  </ThingDef>
  <ThingDef Name="LCOrdeal_RaceWalker" ParentName="LCOrdeal_RaceBase" Abstract="True">
    <statBases><MoveSpeed>4.7</MoveSpeed><ArmorRating_Blunt>0.2</ArmorRating_Blunt><ArmorRating_Sharp>0.4</ArmorRating_Sharp></statBases>
    <race><body>Scyther</body><baseBodySize>1</baseBodySize><baseHealthScale>1.32</baseHealthScale><soundMeleeHitPawn>Pawn_Melee_MechanoidSlash_HitPawn</soundMeleeHitPawn><soundMeleeHitBuilding>Pawn_Melee_MechanoidSlash_HitBuilding</soundMeleeHitBuilding><soundMeleeMiss>Pawn_Melee_MechanoidSlash_Miss</soundMeleeMiss></race>
    <tools><li><label>left blade</label><capacities><li>Cut</li><li>Stab</li></capacities><power>20</power><cooldownTime>2</cooldownTime><linkedBodyPartsGroup>LeftBlade</linkedBodyPartsGroup><alwaysTreatAsWeapon>true</alwaysTreatAsWeapon></li><li><label>right blade</label><capacities><li>Cut</li><li>Stab</li></capacities><power>20</power><cooldownTime>2</cooldownTime><linkedBodyPartsGroup>RightBlade</linkedBodyPartsGroup><alwaysTreatAsWeapon>true</alwaysTreatAsWeapon></li></tools>
  </ThingDef>
  <ThingDef Name="LCOrdeal_RaceHeavy" ParentName="LCOrdeal_RaceBase" Abstract="True">
    <statBases><MoveSpeed>1.9</MoveSpeed><ArmorRating_Blunt>0.22</ArmorRating_Blunt><ArmorRating_Sharp>0.72</ArmorRating_Sharp><PsychicSensitivity>0.75</PsychicSensitivity></statBases>
    <race><body>MechanicalCentipede</body><baseBodySize>3</baseBodySize><baseHealthScale>4.32</baseHealthScale><soundMeleeHitPawn>Pawn_Melee_MechanoidBash_HitPawn</soundMeleeHitPawn><soundMeleeHitBuilding>Pawn_Melee_MechanoidBash_HitBuilding</soundMeleeHitBuilding><soundMeleeMiss>Pawn_Melee_MechanoidBash_Miss</soundMeleeMiss></race>
    <tools><li><label>head</label><capacities><li>Blunt</li></capacities><power>17</power><cooldownTime>2.6</cooldownTime><linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup><ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable></li></tools>
  </ThingDef>

  <!-- Every ordeal PawnKind owns a concrete race Def, even where anatomy/stats share an abstract family. -->

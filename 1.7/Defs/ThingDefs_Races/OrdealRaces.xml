  <!-- ==================== DAWN ORDEALS (TETH): ARTICULATED SPINE RIGS + FULL FOUR-COLOR COMBAT ==================== -->
  <!-- 1. Amber Dawn: The Perfect Food (TETH | HP 35 swarm | RED melee & emergence ambush | R 2.0 / W 1.0 / B 1.0 / P 2.0) -->
  <ThingDef ParentName="LCOrdeal_RaceSmall">
    <defName>LCOrdeal_Race_AmberDawn</defName>
    <label>Perfect Food manifestation</label>
    <description>A ravenous, segmented orange-spotted worm spawned by the Amber Dawn Ordeal (TETH). Individually fragile and highly vulnerable to RED and PALE damage, yet relentless in burrowing swarms that lunge with rapid RED-damage bites.</description>
    <statBases>
      <MoveSpeed>3.85</MoveSpeed>
      <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.12</ArmorRating_Sharp>
      <PsychicSensitivity>0.85</PsychicSensitivity>
    </statBases>
    <race>
      <renderTree>LCOrdeal_Tree_AmberDawn</renderTree>
      <baseBodySize>0.65</baseBodySize>
      <baseHealthScale>0.85</baseHealthScale>
    </race>
    <tools>
      <li>
        <label>chitinous mandibles</label>
        <capacities><li>Bite</li></capacities>
        <power>7.5</power>
        <cooldownTime>1.15</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <comps>
      <li Class="LCAnomalyOrdeals.Comps.CompProperties_DawnOrdeal">
        <archetype>Amber</archetype>
      </li>
    </comps>
    <modExtensions>
      <li Class="LCAnomalyCore.ModExtensions.ModExtension_AbnormalityCategory">
        <abnormalityCategoryDef>TETH</abnormalityCategoryDef>
      </li>
      <li Class="LCAnomalyCore.ModExtensions.FourColorTargetExtension">
        <targetKind>Abnormality</targetKind>
        <redResistance>2.0</redResistance>
        <whiteResistance>1.0</whiteResistance>
        <blackResistance>1.0</blackResistance>
        <paleResistance>2.0</paleResistance>
      </li>
      <li Class="LCAnomalyCore.ModExtensions.FourColorWeaponExtension">
        <damageType>Red</damageType>
        <riskLevel>TETH</riskLevel>
      </li>
    </modExtensions>
  </ThingDef>

